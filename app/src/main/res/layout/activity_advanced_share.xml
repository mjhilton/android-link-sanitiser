<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/advanced_title"
            android:textStyle="bold"
            android:textSize="18sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCleanSurroundingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_clean_surrounding_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="20dp"
            android:alpha="0.7"
            android:text="@string/setting_clean_surrounding_text_desc"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/setting_links_to_keep"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/linksToKeepGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/linksToKeepAll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/links_to_keep_all" />

            <RadioButton
                android:id="@+id/linksToKeepFirst"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/links_to_keep_first" />

            <RadioButton
                android:id="@+id/linksToKeepChoose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/links_to_keep_choose" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:alpha="0.7"
            android:text="@string/advanced_tracking_heading"
            android:textStyle="bold"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripUtm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_strip_utm" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripClickIds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setting_strip_click_ids" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripReferral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/setting_strip_referral" />

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/advanced_share" />

    </LinearLayout>

</ScrollView>
