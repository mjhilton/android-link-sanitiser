<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/custom_title"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.7"
            android:text="@string/custom_shared_text_heading"
            android:textStyle="bold"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/preview_card_background"
            app:cardElevation="0dp"
            app:cardCornerRadius="8dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="76dp">

                <TextView
                    android:id="@+id/sharedTextPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:text="" />

            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchCleanSurroundingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_clean_surrounding_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="@string/setting_clean_surrounding_text_desc"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripUtm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_strip_utm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="@string/setting_strip_utm_desc"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripClickIds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_strip_click_ids" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="@string/setting_strip_click_ids_desc"
            android:textSize="12sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchStripReferral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_strip_referral" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="16dp"
            android:alpha="0.7"
            android:text="@string/setting_strip_referral_desc"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/domainSpecificSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchStripDomainSpecific"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_strip_domain_specific" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:alpha="0.7"
                android:text="@string/setting_strip_domain_specific_desc"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/linksSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="4dp"
                android:text="@string/custom_links_heading"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="12dp"
                android:alpha="0.7"
                android:text="@string/custom_links_subheading"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/linksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:alpha="0.7"
            android:text="@string/custom_preview_heading"
            android:textStyle="bold"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/preview_card_background"
            app:cardElevation="0dp"
            app:cardCornerRadius="8dp">

            <TextView
                android:id="@+id/previewText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:text="" />

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/shareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/custom_share" />

    </LinearLayout>

</ScrollView>
